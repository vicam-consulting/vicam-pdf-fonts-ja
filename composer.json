{
    "name": "vicam/pdf-fonts-ja",
    "description": "Static Noto Sans and Serif JP Regular for Vicam PDF forms and overlays.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "vicam/pdf": "^0.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Vicam\\Pdf\\FontsJa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vicam\\Pdf\\FontsJa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
